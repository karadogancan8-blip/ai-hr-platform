# Vercel / canlı ortam değişkenleri şablonu.
# Gerçek değerleri Vercel Project Settings → Environment Variables içine ekleyin.
# Bu dosyayı kopyalayıp doldurmayın; .env.production dosyası git'e gitmez.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Gemini (zorunlu AI yolu). GOOGLE_GENERATIVE_AI_API_KEY da kabul edilir.
GEMINI_API_KEY=your_gemini_api_key

# İsteğe bağlı hibrit yedek: Gemini başarısız olursa Claude kullanılır.
ANTHROPIC_API_KEY=

# Canlı domain (sonunda / olmasın). Auth yönlendirmeleri ve paylaşım linkleri için.
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
